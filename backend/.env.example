# Mongo connection string (Atlas)
CONN_STR=

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# ImageKit credentials
IMAGEKIT_PUBLICKEY=
IMAGEKIT_PRIVATEKEY=
IMAGEKIT_URLENDPOINT=

# Server
PORT=8080
NODE_ENV=development

# Public URL used for the keep-alive self-ping (production only)
SELF_PING_URL=

# Transition flag: allow order creation without a JWT so that already-published
# app builds keep working. Set to "true" ONLY during an app rollout window,
# then remove it. Defaults to false (auth required).
ALLOW_LEGACY_UNAUTHED_ORDERS=false
